#!/usr/bin/env bash
set -euo pipefail

# Root-owned privilege boundary. It deliberately exposes no force, reload,
# runtime-argument, path, image, or service controls.
MANAGER="${FLIGHT_ENGINEER_MANAGER:-/usr/local/bin/jarvis-model-profile}"

case "${1:-}" in
  use)
    profile="${2:-}"
    if [[ $# -ne 2 || ! "$profile" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]; then
      echo "usage: flight-engineer-control use PROFILE_ID" >&2
      exit 2
    fi
    exec "$MANAGER" use "$profile"
    ;;
  rollback)
    if [[ $# -ne 1 ]]; then
      echo "usage: flight-engineer-control rollback" >&2
      exit 2
    fi
    exec "$MANAGER" rollback
    ;;
  *)
    echo "usage: flight-engineer-control use PROFILE_ID | rollback" >&2
    exit 2
    ;;
esac

